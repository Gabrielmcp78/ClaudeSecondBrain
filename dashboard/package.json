{
  "name": "secondbrain-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "concurrently \"pnpm run server:dev\" \"vite --port=10889 --host=0.0.0.0\"",
    "server:dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && pnpm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --outfile=dist-server/index.cjs --format=cjs --external:express --external:cors --external:cookie-parser --external:chokidar --external:fs --external:path --external:url --external:os --external:child_process --external:crypto --external:dotenv",
    "serve": "node dist-server/index.cjs",
    "start": "pnpm run build && pnpm run serve",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "^4.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
