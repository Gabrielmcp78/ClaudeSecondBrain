# SecondBrain Dashboard — server environment variables
# Copy to .env (gitignored) and adjust for your deployment.

# Public hostname the dashboard is reachable at. Used to build invite
# links for new members (Setup → Members). Leave as localhost if every
# member is on Gabriel's local network. If any member is remote, set this
# to whatever hostname/tunnel reaches the dashboard from outside — e.g.
# a Tailscale MagicDNS name, a Cloudflare Tunnel hostname, or a
# router-forwarded public domain. See README § Remote members.
PUBLIC_URL=http://localhost:10888

# Set to "true" once the dashboard is served over HTTPS (recommended for
# any remote/off-network access) so session cookies get the Secure flag.
# Leave "false" for plain-http localhost/LAN use.
COOKIE_SECURE=false

# How long a signed-in session stays valid before re-login is required.
SESSION_TTL_DAYS=30

# How long an invite link stays valid before it must be resent.
INVITE_TTL_DAYS=7
